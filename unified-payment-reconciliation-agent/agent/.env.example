# ============================================================
# Unified Stream · AI Agent Environment Variables
# ============================================================

PORT=5000
NODE_ENV=development

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
# Options: gemini-1.5-flash (faster/cheaper) | gemini-1.5-pro (better quality)
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# IMPORTANT: The agent NEVER makes classification decisions.
# It only receives pre-computed results from the backend
# and generates natural-language explanations/summaries.
# ============================================================
